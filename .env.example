# ========================================================
# Six Cards — Environment Configuration Template
# ========================================================

# Active Application Profile: dev | prod | test
APP_PROFILE=dev

# Server Port
PORT=3001

# PostgreSQL Database Connection String
# For Local Postgres: postgresql://postgres:postgres@localhost:5432/sixcardgame
# For Supabase (Production): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sixcardgame

# Allowed CORS Origins (Comma-separated in production)
# Example: https://six-cards-game.vercel.app,https://mycardgame.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Client-facing API URLs (Vite)
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
