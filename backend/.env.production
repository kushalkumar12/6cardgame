# Backend Production Profile (Render deployment)
APP_PROFILE=prod
PORT=3001

# Supabase PostgreSQL Connection String (Transaction Pooler or Session Pooler):
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Allowed Frontend Origins (Your Vercel deployment URL):
ALLOWED_ORIGINS=https://your-frontend.vercel.app
